{
  "info": {
    "name": "Actuent API",
    "description": "Actuent is a search engine for AI agents. Search any topic or domain and get websites back as LAWP: structured JSON with each site's pages and the actions a visitor can take. Free without a key (20 requests/min); Pro API keys from actuent.ai give full results and 60 requests/min.\n\nGenerated from https://api.actuent.ai/openapi.json. Set actuent_api_key for Pro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.actuent.ai"
    },
    {
      "key": "actuent_api_key",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Search websites and products as structured LAWP",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{actuent_api_key}}",
            "description": "Optional: your Pro API key",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/search?q=running shoes under €100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "running shoes under €100",
              "description": "Topic, name, domain, domain/path, 'A vs B' comparison, or a product search with a price ('running shoes under 800 dkk')",
              "disabled": false
            },
            {
              "key": "limit",
              "value": "",
              "description": "Results per page",
              "disabled": true
            },
            {
              "key": "offset",
              "value": "",
              "description": "Paging offset",
              "disabled": true
            },
            {
              "key": "category",
              "value": "",
              "description": "Only this kind of site: restaurant, cafe, software, shop_fashion…",
              "disabled": true
            },
            {
              "key": "city",
              "value": "",
              "description": "Only businesses in this city",
              "disabled": true
            },
            {
              "key": "open_now",
              "value": "",
              "description": "Only places open right now (holiday hours respected)",
              "disabled": true
            },
            {
              "key": "lang",
              "value": "",
              "description": "Sites in this language first (ISO 639-1)",
              "disabled": true
            },
            {
              "key": "sort",
              "value": "",
              "description": "",
              "disabled": true
            },
            {
              "key": "fast",
              "value": "",
              "description": "A quick first answer (best-known sites, exact name, local businesses) in well under a second",
              "disabled": true
            }
          ]
        },
        "description": "Search by topic (\"barber amsterdam\", \"running shoes under €100\"), domain (\"nike.com\") or page (\"stripe.com/pricing\"). Queries in any language are answered in English. Each result and product has a visit_url: use it when giving the user a link."
      }
    },
    {
      "name": "Search (POST form)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{actuent_api_key}}",
            "description": "Optional: your Pro API key",
            "disabled": true
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/search",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "search"
          ],
          "query": []
        },
        "description": "Search (POST form)",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"barber amsterdam\"\n}"
        }
      }
    },
