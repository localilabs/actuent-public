{
  "version": 2,
  "builds": [
    {
      "src": "api/search.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/register.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/well-known.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/badge.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/stats.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/diff.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/sitemap.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/leaderboard.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/suggest.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/webhook-register.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/state.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/site.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/og.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "public/state.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/openapi.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/docs/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; connect-src 'self' https://api.actuent.ai https://agents.actuent.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/api/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/register",
      "dest": "/api/register.ts"
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.ts"
    },
    {
      "src": "/api/diff",
      "dest": "/api/diff.ts"
    },
    {
      "src": "/api/leaderboard",
      "dest": "/api/leaderboard.ts"
    },
    {
      "src": "/api/suggest",
      "dest": "/api/suggest.ts"
    },
    {
      "src": "/api/webhook-register",
      "dest": "/api/webhook-register.ts"
    },
    {
      "src": "/api/state",
      "dest": "/api/state.ts"
    },
    {
      "src": "/state",
      "dest": "/public/state.html"
    },
    {
      "src": "/openapi.json",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/public/openapi.json"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.ts"
    },
    {
      "src": "/sitemap-sites-([0-9]+)\\.xml",
      "dest": "/api/sitemap.ts?part=$1"
    },
    {
      "src": "/site/?",
      "dest": "/api/site.ts"
    },
    {
      "src": "/site/([^/?]+)/?",
      "dest": "/api/site.ts?domain=$1"
    },
    {
      "src": "/og",
      "dest": "/api/og.ts"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/leaderboard",
      "dest": "/api/leaderboard.ts"
    },
    {
      "src": "/suggest",
      "dest": "/api/suggest.ts"
    },
    {
      "src": "/.well-known/lawp.json",
      "dest": "/api/well-known.ts"
    },
    {
      "src": "/badge.svg",
      "dest": "/api/badge.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/docs",
      "dest": "/public/docs/index.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ]
}
