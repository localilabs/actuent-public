{
  "version": 2,
  "regions": [
    "dub1"
  ],
  "builds": [
    {
      "src": "api/search.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/places/**"
        ]
      }
    },
    {
      "src": "api/data.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/register.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/well-known.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/badge.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@vercel/og/**"
        ]
      }
    },
    {
      "src": "api/sitemap.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/suggest.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/site.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "public/llms.txt",
      "use": "@vercel/static"
    },
    {
      "src": "public/badge.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/state.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/openapi.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/docs/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/ask.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/actuent.postman_collection.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/404.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/checklist.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/whatson.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; connect-src 'self' https://api.actuent.ai https://agents.actuent.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/badge\\.(svg|json)",
      "has": [
        {
          "type": "query",
          "key": "lawp"
        }
      ],
      "dest": "/api/badge.ts?format=$1"
    },
    {
      "src": "/lawp/([a-z0-9.-]+)\\.json",
      "dest": "/api/site.ts?domain=$1&format=lawp&hosted=1"
    },
    {
      "src": "/api/state",
      "dest": "/api/data.ts?op=state"
    },
    {
      "src": "/smarter/?",
      "dest": "/api/site.ts?smarter=1"
    },
    {
      "src": "/share/?",
      "dest": "/api/site.ts?share=1"
    },
    {
      "src": "/deals\\.rss",
      "dest": "/api/site.ts?deals=rss"
    },
    {
      "src": "/deals/?",
      "dest": "/api/site.ts?deals=page"
    },
    {
      "src": "/status/?",
      "dest": "/api/site.ts?status=page"
    },
    {
      "src": "/brand/([^/?]+)/?",
      "dest": "/api/site.ts?brand=$1"
    },
    {
      "src": "/site/in/([^/?]+)/new\\.rss",
      "dest": "/api/site.ts?city=$1&new=rss"
    },
    {
      "src": "/site/in/([^/?]+)/new/?",
      "dest": "/api/site.ts?city=$1&new=page"
    },
    {
      "src": "/site/in/([^/?]+)/([^/?]+)/best/?",
      "dest": "/api/site.ts?city=$1&category=$2&best=1"
    },
    {
      "src": "/(api/(?:stats|diff|leaderboard|autocomplete|similar|status|state|warm|site-search|rates|events|recently-fixed|player|discord/[0-9a-fA-F]{64})|trends(?:\\.json|/?)|changes\\.rss|state/weekly(?:\\.rss|/.*)?|sitemap(?:-cities|-sites-[0-9]+)?\\.xml|site(?:/.*)?|leaderboard|status/?|share/?|smarter/?|brand/[^/?]+/?|deals(?:\\.rss|/?)|\\.well-known/lawp\\.json|badge\\.(?:json|svg))",
      "dest": "https://bcmwypjrahtxogytsvuc.supabase.co/functions/v1/api/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1"
      }
    },
    {
      "src": "/api/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/register",
      "dest": "/api/register.ts"
    },
    {
      "src": "/api/stats",
      "dest": "/api/data.ts?op=stats"
    },
    {
      "src": "/api/diff",
      "dest": "/api/data.ts?op=diff"
    },
    {
      "src": "/api/leaderboard",
      "dest": "/api/data.ts?op=leaderboard"
    },
    {
      "src": "/api/suggest",
      "dest": "/api/suggest.ts"
    },
    {
      "src": "/api/webhook-register",
      "dest": "/api/data.ts?op=webhooks"
    },
    {
      "src": "/api/autocomplete",
      "dest": "/api/data.ts?op=autocomplete"
    },
    {
      "src": "/api/ask",
      "dest": "/api/data.ts?op=ask"
    },
    {
      "src": "/api/similar",
      "dest": "/api/data.ts?op=similar"
    },
    {
      "src": "/api/tonight",
      "dest": "/api/data.ts?op=tonight"
    },
    {
      "src": "/api/sitemap-pages",
      "dest": "/api/data.ts?op=sitemap_pages"
    },
    {
      "src": "/api/checkup",
      "dest": "/api/data.ts?op=checkup"
    },
    {
      "src": "/api/newsletter",
      "dest": "/api/data.ts?op=newsletter"
    },
    {
      "src": "/api/slack",
      "dest": "/api/data.ts?op=slack"
    },
    {
      "src": "/api/status",
      "dest": "/api/data.ts?op=status"
    },
    {
      "src": "/api/state",
      "dest": "/api/data.ts?op=state"
    },
    {
      "src": "/api/unsubscribe",
      "dest": "/api/data.ts?op=unsubscribe"
    },
    {
      "src": "/go",
      "dest": "/api/data.ts?op=go"
    },
    {
      "src": "/indexnow\\.txt",
      "dest": "/api/data.ts?op=indexnow"
    },
    {
      "src": "/trends\\.json",
      "dest": "/api/site.ts?trends=json"
    },
    {
      "src": "/trends/?",
      "dest": "/api/site.ts?trends=html"
    },
    {
      "src": "/changes\\.rss",
      "dest": "/api/site.ts?changes=rss"
    },
    {
      "src": "/state/weekly\\.rss",
      "dest": "/api/site.ts?weekly=rss"
    },
    {
      "src": "/state/weekly/([0-9]{4}-[0-9]{2}-[0-9]{2})/?",
      "dest": "/api/site.ts?weekly=$1"
    },
    {
      "src": "/state/weekly/?",
      "dest": "/api/site.ts?weekly=index"
    },
    {
      "src": "/state",
      "dest": "/public/state.html"
    },
    {
      "src": "/openapi.json",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/public/openapi.json"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.ts"
    },
    {
      "src": "/sitemap-cities\\.xml",
      "dest": "/api/sitemap.ts?part=cities"
    },
    {
      "src": "/sitemap-sites-([0-9]+)\\.xml",
      "dest": "/api/sitemap.ts?part=$1"
    },
    {
      "src": "/site/in/([^/?]+)/whats-on\\.ics",
      "dest": "/api/site.ts?city=$1&events=ics"
    },
    {
      "src": "/site/in/([^/?]+)/whats-on/?",
      "dest": "/api/site.ts?city=$1&events=page"
    },
    {
      "src": "/site/in/([^/?]+)/([^/?]+)/?",
      "dest": "/api/site.ts?city=$1&category=$2"
    },
    {
      "src": "/site/in/([^/?]+)/?",
      "dest": "/api/site.ts?city=$1"
    },
    {
      "src": "/site/?",
      "dest": "/api/site.ts"
    },
    {
      "src": "/site/([^/?]+)/changes\\.rss",
      "dest": "/api/site.ts?domain=$1&changes=rss"
    },
    {
      "src": "/site/([^/?]+)/?",
      "dest": "/api/site.ts?domain=$1"
    },
    {
      "src": "/og",
      "dest": "/api/badge.ts?op=og"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/llms.txt",
      "dest": "/public/llms.txt",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/leaderboard",
      "dest": "/api/data.ts?op=leaderboard"
    },
    {
      "src": "/suggest",
      "dest": "/api/suggest.ts"
    },
    {
      "src": "/.well-known/lawp.json",
      "dest": "/api/well-known.ts"
    },
    {
      "src": "/badge.json",
      "dest": "/api/badge.ts?format=json"
    },
    {
      "src": "/badge.js",
      "dest": "/public/badge.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/ask.js",
      "dest": "/public/ask.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/checklist.js",
      "dest": "/public/checklist.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/whatson.js",
      "dest": "/public/whatson.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/actuent.postman_collection.json",
      "dest": "/public/actuent.postman_collection.json",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Content-Disposition": "attachment; filename=\"actuent.postman_collection.json\""
      }
    },
    {
      "src": "/badge.svg",
      "dest": "/api/badge.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/docs",
      "dest": "/public/docs/index.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/public/404.html"
    }
  ]
}
