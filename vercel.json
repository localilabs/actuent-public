{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "builds": [
    { "src": "api/search.ts", "use": "@vercel/node" },
    { "src": "api/register.ts", "use": "@vercel/node" },
    { "src": "api/well-known.ts", "use": "@vercel/node" },
    { "src": "api/badge.ts", "use": "@vercel/node" },
    { "src": "api/stats.ts", "use": "@vercel/node" },
    { "src": "public/index.html", "use": "@vercel/static" },
    { "src": "public/docs/index.html", "use": "@vercel/static" },
    { "src": "public/assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/search", "dest": "/api/search.ts" },
    { "src": "/api/register", "dest": "/api/register.ts" },
    { "src": "/api/stats", "dest": "/api/stats.ts" },
    { "src": "/.well-known/lawp.json", "dest": "/api/well-known.ts" },
    { "src": "/badge.svg", "dest": "/api/badge.ts" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/docs", "dest": "/public/docs/index.html" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
